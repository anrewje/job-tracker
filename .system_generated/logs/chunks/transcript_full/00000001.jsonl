{"step_index":47,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-16T14:26:41Z","tool_calls":[{"name":"run_command","args":{"CommandLine":"Set-Content -Encoding UTF8 -Path \"C:\\Users\\nise0\\.gemini\\antigravity\\scratch\\melekhov_resume\\hh_search.py\" -Value @'\n\"\"\"\nhh_search.py - поиск удаленных IT-вакансий через публичный API hh.ru\nЗапуск: python hh_search.py\n\"\"\"\n\nimport urllib.request\nimport urllib.parse\nimport json\n\nSEARCH_QUERIES = [\n    \"системный администратор\",\n    \"сетевой администратор\",\n    \"linux администратор\",\n    \"helpdesk\",\n    \"IT поддержка\",\n    \"NOC инженер\",\n    \"junior devops\",\n    \"IT support\",\n]\n\nAREA = \"113\"\nSCHEDULE = \"remote\"\nEXPERIENCE = \"noExperience\"\nPER_PAGE = 20\nBASE_URL = \"https://api.hh.ru/vacancies\"\nHEADERS = {\"User-Agent\": \"vacancy-search/1.0 (anrewje@gmail.com)\"}\n\n\ndef fetch_vacancies(query):\n    params = urllib.parse.urlencode({\n        \"text\": query, \"area\": AREA, \"schedule\": SCHEDULE,\n        \"experience\": EXPERIENCE, \"per_page\": PER_PAGE,\n        \"order_by\": \"publication_time\",\n    })\n    req = urllib.request.Request(f\"{BASE_URL}?{params}\", headers=HEADERS)\n    try:\n        with urllib.request.urlopen(req, timeout=10) as r:\n            return json.loads(r.read().decode(\"utf-8\")).get(\"items\", [])\n    except Exception as e:\n        print(f\"  [!] Ошибка '{query}': {e}\")\n        return []\n\n\ndef fmt_salary(s):\n    if not s:\n        return \"не указана\"\n    c = s.get(\"currency\", \"\")\n    f, t = s.get(\"from\"), s.get(\"to\")\n    if f and t: return f\"{f:,} - {t:,} {c}\"\n    if f: return f\"от {f:,} {c}\"\n    if t: return f\"до {t:,} {c}\"\n    return \"не указана\"\n\n\ndef main():\n    print(\"=\" * 62)\n    print(\"  Поиск удаленных IT-вакансий | Мелехов Андрей\")\n    print(\"=\" * 62)\n\n    all_vac, seen = [], set()\n    for q in SEARCH_QUERIES:\n        print(f\"\\n Запрос: {q}\")\n        items = fetch_vacancies(q)\n        added = 0\n        for v in items:\n            if v.get(\"id\") not in seen:\n                seen.add(v.get(\"id\"))\n                all_vac.append(v)\n                added += 1\n        print(f\"   +{added} новых\")\n\n    all_vac.sort(key=lambda v: v.get(\"published_at\", \"\"), reverse=True)\n    print(f\"\\n{'='*62}\")\n    print(f\"  Итого уникальных вакансий: {len(all_vac)}\")\n    print(f\"{'='*62}\")\n\n    for i, v in enumerate(all_vac, 1):\n        name = v.get(\"name\", \"-\")\n        emp  = v.get(\"employer\", {}).get(\"name\", \"-\")\n        sal  = fmt_salary(v.get(\"salary\"))\n        url  = v.get(\"alternate_url\", \"\")\n        date = v.get(\"published_at\", \"\")[:10]\n        print(f\"\\n  #{i:02d} {name}\")\n        print(f\"       Компания : {emp}\")\n        print(f\"       Зарплата : {sal}\")\n        print(f\"       Дата     : {date}\")\n        print(f\"       Ссылка   : {url}\")\n\n    with open(\"vacancies.json\", \"w\", encoding=\"utf-8\") as f:\n        json.dump(all_vac, f, ensure_ascii=False, indent=2)\n\n    print(f\"\\n Результаты сохранены в vacancies.json\")\n    print(f\"\\n Прямая ссылка на hh.ru (открой в браузере):\")\n    print(\"  https://hh.ru/search/vacancy?schedule=remote&experience=noExperience&text=системный+администратор\")\n\n\nif __name__ == \"__main__\":\n    main()\n'@","Cwd":"C:\\Users\\nise0\\.gemini\\antigravity\\scratch\\melekhov_resume","WaitMsBeforeAsync":5000,"toolAction":"Writing search script","toolSummary":"hh_search.py creation"}}]}
