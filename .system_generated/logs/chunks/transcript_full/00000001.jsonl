{"step_index":43,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-16T14:26:03Z","content":"Python установлен. Создаю скрипт для поиска вакансий и автооткликов:","tool_calls":[{"name":"write_to_file","args":{"ArtifactMetadata":{"RequestFeedback":false,"Summary":"Python-скрипт для поиска удалённых IT-вакансий через публичный API hh.ru без авторизации. Ищет вакансии Junior сисадмин/сетевой/хелпдеск без опыта (удалённо), выводит список с названием, компанией, зарплатой и ссылкой. Сохраняет результаты в vacancies.json для просмотра.","UserFacing":false},"CodeContent":"\"\"\"\nhh_search.py — поиск удалённых IT-вакансий через публичный API hh.ru\nАвтор: Antigravity для Мелехова Андрея\n\nЗапуск: python hh_search.py\n\"\"\"\n\nimport urllib.request\nimport urllib.parse\nimport json\nimport sys\n\n# ──────────────────────────────────────────────\n# Настройки поиска\n# ──────────────────────────────────────────────\nSEARCH_QUERIES = [\n    \"системный администратор\",\n    \"сетевой администратор\",\n    \"linux администратор\",\n    \"helpdesk\",\n    \"IT поддержка\",\n    \"NOC инженер\",\n    \"junior devops\",\n]\n\nAREA = \"113\"          # Россия\nSCHEDULE = \"remote\"   # Только удалённо\nEXPERIENCE = \"noExperience\"  # Без опыта\nPER_PAGE = 20\n\nBASE_URL = \"https://api.hh.ru/vacancies\"\nHEADERS = {\n    \"User-Agent\": \"vacancy-search-script/1.0 (anrewje@gmail.com)\"\n}\n\n# ──────────────────────────────────────────────\n# Функции\n# ──────────────────────────────────────────────\n\ndef fetch_vacancies(query: str) -> list:\n    \"\"\"Запрашивает вакансии по одному поисковому запросу.\"\"\"\n    params = urllib.parse.urlencode({\n        \"text\": query,\n        \"area\": AREA,\n        \"schedule\": SCHEDULE,\n        \"experience\": EXPERIENCE,\n        \"per_page\": PER_PAGE,\n        \"order_by\": \"publication_time\",  # Сначала свежие\n    })\n    url = f\"{BASE_URL}?{params}\"\n\n    req = urllib.request.Request(url, headers=HEADERS)\n    try:\n        with urllib.request.urlopen(req, timeout=10) as response:\n            data = json.loads(response.read().decode(\"utf-8\"))\n            return data.get(\"items\", [])\n    except Exception as e:\n        print(f\"  [!] Ошибка при запросе '{query}': {e}\")\n        return []\n\n\ndef format_salary(salary: dict | None) -> str:\n    \"\"\"Форматирует зарплату в читаемый вид.\"\"\"\n    if not salary:\n        return \"не указана\"\n    currency = salary.get(\"currency\", \"\")\n    from_s = salary.get(\"from\")\n    to_s = salary.get(\"to\")\n    if from_s and to_s:\n        return f\"{from_s:,} – {to_s:,} {currency}\"\n    elif from_s:\n        return f\"от {from_s:,} {currency}\"\n    elif to_s:\n        return f\"до {to_s:,} {currency}\"\n    return \"не указана\"\n\n\ndef print_vacancy(i: int, v: dict):\n    \"\"\"Красиво выводит одну вакансию.\"\"\"\n    name = v.get(\"name\", \"—\")\n    employer = v.get(\"employer\", {}).get(\"name\", \"—\")\n    salary = format_salary(v.get(\"salary\"))\n    url = v.get(\"alternate_url\", \"\")\n    published = v.get(\"published_at\", \"\")[:10]\n\n    print(f\"\\n{'─'*60}\")\n    print(f\"  #{i:02d} | {name}\")\n    print(f\"       Компания : {employer}\")\n    print(f\"       Зарплата : {salary}\")\n    print(f\"       Дата     : {published}\")\n    print(f\"       Ссылка   : {url}\")\n\n\n# ──────────────────────────────────────────────\n# Главная логика\n# ──────────────────────────────────────────────\n\ndef main():\n    print(\"=\" * 60)\n    print(\"  Поиск удалённых IT-вакансий для Мелехова Андрея\")\n    print(\"=\" * 60)\n\n    all_vacancies = []\n    seen_ids = set()\n\n    for query in SEARCH_QUERIES:\n        print(f\"\\n🔍 Поисковый запрос: «{query}»\")\n        items = fetch_vacancies(query)\n        new_count = 0\n        for item in items:\n            vid = item.get(\"id\")\n            if vid not in seen_ids:\n                seen_ids.add(vid)\n                all_vacancies.append(item)\n                new_count += 1\n        print(f\"   Найдено новых: {new_count}\")\n\n    print(f\"\\n{'='*60}\")\n    print(f\"  Всего уникальных вакансий: {len(all_vacancies)}\")\n    print(f\"{'='*60}\")\n\n    # Сортируем по дате публикации (свежие первые)\n    all_vacancies.sort(key=lambda v: v.get(\"published_at\", \"\"), reverse=True)\n\n    # Выводим список\n    for i, v in enumerate(all_vacancies, 1):\n        print_vacancy(i, v)\n\n    # Сохраняем в JSON для дальнейшего использования\n    output_file = \"vacancies.json\"\n    with open(output_file, \"w\", encoding=\"utf-8\") as f:\n        json.dump(all_vacancies, f, ensure_ascii=False, indent=2)\n\n    print(f\"\\n\\n✅ Результаты сохранены в {output_file}\")\n    print(f\"   Открой ссылки из списка выше и откликайся с шаблонами писем!\")\n    print(f\"\\n💡 Быстрый поиск на hh.ru (открой в браузере):\")\n    print(\"   https://hh.ru/search/vacancy?schedule=remote&experience=noExperience&text=системный+администратор\")\n\n\nif __name__ == \"__main__\":\n    main()\n","Description":"Скрипт поиска вакансий через публичный API hh.ru без OAuth-авторизации","Overwrite":false,"TargetFile":"C:\\Users\\nise0\\.gemini\\antigravity\\scratch\\melekhov_resume\\hh_search.py","toolAction":"Creating vacancy search script","toolSummary":"hh.ru vacancy search script"}}]}
