{"step_index":57,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-16T14:27:31Z","content":"hh.ru API полностью заблокировал прямые запросы без OAuth-токена. Напишу полноценный скрипт с OAuth-авторизацией через браузер:","tool_calls":[{"name":"run_command","args":{"CommandLine":"Set-Content -Encoding UTF8 -Path \"C:\\Users\\nise0\\.gemini\\antigravity\\scratch\\melekhov_resume\\hh_vacancies.py\" -Value @'\n\"\"\"\nhh_vacancies.py - Поиск вакансий через hh.ru API с OAuth авторизацией\n=======================================================================\nШаг 1: Зарегистрируй приложение на https://dev.hh.ru/admin\n        - Название: любое (например \"vacancy-search\")\n        - redirect_uri: http://localhost:8765/callback\n\nШаг 2: Вставь CLIENT_ID и CLIENT_SECRET ниже\n\nШаг 3: Запусти скрипт: python hh_vacancies.py\n        Откроется браузер для авторизации, после чего скрипт\n        автоматически получит токен и найдет вакансии.\n\"\"\"\n\nimport webbrowser\nimport threading\nimport json\nimport urllib.parse\nimport urllib.request\nfrom http.server import HTTPServer, BaseHTTPRequestHandler\n\n# =====================================================\n# ЗАПОЛНИ СВОИ ДАННЫЕ (https://dev.hh.ru/admin)\n# =====================================================\nCLIENT_ID     = \"ВСТАВЬ_CLIENT_ID\"\nCLIENT_SECRET = \"ВСТАВЬ_CLIENT_SECRET\"\nREDIRECT_URI  = \"http://localhost:8765/callback\"\n# =====================================================\n\nAUTH_URL   = \"https://hh.ru/oauth/authorize\"\nTOKEN_URL  = \"https://hh.ru/oauth/token\"\nAPI_BASE   = \"https://api.hh.ru\"\nHEADERS    = {\"User-Agent\": \"vacancy-search/1.0 (anrewje@gmail.com)\"}\n\nSEARCH_QUERIES = [\n    \"системный администратор\",\n    \"сетевой администратор\",\n    \"linux администратор\",\n    \"helpdesk\",\n    \"IT поддержка\",\n    \"NOC инженер\",\n    \"junior devops\",\n    \"IT support\",\n]\n\naccess_token = None\nauth_code = None\n\n\nclass CallbackHandler(BaseHTTPRequestHandler):\n    def do_GET(self):\n        global auth_code\n        parsed = urllib.parse.urlparse(self.path)\n        params = urllib.parse.parse_qs(parsed.query)\n        auth_code = params.get(\"code\", [None])[0]\n        self.send_response(200)\n        self.send_header(\"Content-type\", \"text/html; charset=utf-8\")\n        self.end_headers()\n        msg = \"<h2>Авторизация прошла успешно! Вернись в консоль.</h2>\"\n        self.wfile.write(msg.encode())\n\n    def log_message(self, *args):\n        pass  # Отключаем логи сервера\n\n\ndef get_access_token(code):\n    data = urllib.parse.urlencode({\n        \"grant_type\":    \"authorization_code\",\n        \"client_id\":     CLIENT_ID,\n        \"client_secret\": CLIENT_SECRET,\n        \"code\":          code,\n        \"redirect_uri\":  REDIRECT_URI,\n    }).encode()\n    req = urllib.request.Request(TOKEN_URL, data=data, method=\"POST\")\n    with urllib.request.urlopen(req, timeout=15) as resp:\n        return json.loads(resp.read().decode())[\"access_token\"]\n\n\ndef api_get(endpoint, params=None):\n    url = f\"{API_BASE}{endpoint}\"\n    if params:\n        url += \"?\" + urllib.parse.urlencode(params)\n    req = urllib.request.Request(url, headers={\n        **HEADERS,\n        \"Authorization\": f\"Bearer {access_token}\",\n    })\n    with urllib.request.urlopen(req, timeout=10) as resp:\n        return json.loads(resp.read().decode())\n\n\ndef fmt_salary(s):\n    if not s: return \"не указана\"\n    c = s.get(\"currency\", \"\")\n    f, t = s.get(\"from\"), s.get(\"to\")\n    if f and t: return f\"{f:,} - {t:,} {c}\"\n    if f: return f\"от {f:,} {c}\"\n    if t: return f\"до {t:,} {c}\"\n    return \"не указана\"\n\n\ndef search_all():\n    all_vac, seen = [], set()\n    for q in SEARCH_QUERIES:\n        print(f\"  Поиск: {q} ...\", end=\" \", flush=True)\n        try:\n            data = api_get(\"/vacancies\", {\n                \"text\": q, \"area\": \"113\", \"schedule\": \"remote\",\n                \"experience\": \"noExperience\", \"per_page\": 20,\n                \"order_by\": \"publication_time\",\n            })\n            added = 0\n            for v in data.get(\"items\", []):\n                if v[\"id\"] not in seen:\n                    seen.add(v[\"id\"])\n                    all_vac.append(v)\n                    added += 1\n            print(f\"+{added}\")\n        except Exception as e:\n            print(f\"ошибка: {e}\")\n    return all_vac\n\n\ndef main():\n    global access_token, auth_code\n\n    if CLIENT_ID == \"ВСТАВЬ_CLIENT_ID\":\n        print(\"=\" * 62)\n        print(\"  ИНСТРУКЦИЯ ПО НАСТРОЙКЕ\")\n        print(\"=\" * 62)\n        print(\"\"\"\n1. Открой: https://dev.hh.ru/admin\n2. Нажми «Добавить приложение»\n3. Заполни:\n   - Название: vacancy-search\n   - redirect_uri: http://localhost:8765/callback\n4. Скопируй Client ID и Client Secret\n5. Вставь их в начало этого скрипта (CLIENT_ID / CLIENT_SECRET)\n6. Запусти снова: python hh_vacancies.py\n\"\"\")\n        return\n\n    # Запускаем локальный сервер для перехвата callback\n    server = HTTPServer((\"localhost\", 8765), CallbackHandler)\n    t = threading.Thread(target=server.handle_request)\n    t.start()\n\n    # Открываем браузер для авторизации\n    auth_url = (\n        f\"{AUTH_URL}?response_type=code\"\n        f\"&client_id={CLIENT_ID}\"\n        f\"&redirect_uri={urllib.parse.quote(REDIRECT_URI)}\"\n    )\n    print(\"\\n  Открываю браузер для авторизации на hh.ru ...\")\n    webbrowser.open(auth_url)\n\n    t.join(timeout=120)\n    server.server_close()\n\n    if not auth_code:\n        print(\"  [!] Авторизация не завершена\")\n        return\n\n    print(\"  Авторизация успешна! Получаю токен ...\")\n    access_token = get_access_token(auth_code)\n\n    print(\"\\n\" + \"=\" * 62)\n    print(\"  Ищу вакансии ...\")\n    print(\"=\" * 62)\n    vacancies = search_all()\n    vacancies.sort(key=lambda v: v.get(\"published_at\", \"\"), reverse=True)\n\n    print(f\"\\n  Итого: {len(vacancies)} вакансий\\n\")\n    for i, v in enumerate(vacancies, 1):\n        sal  = fmt_salary(v.get(\"salary\"))\n        date = v.get(\"published_at\", \"\")[:10]\n        print(f\"  #{i:02d} {v['name']}\")\n        print(f\"       {v.get('employer', {}).get('name', '-')} | {sal} | {date}\")\n        print(f\"       {v['alternate_url']}\\n\")\n\n    with open(\"vacancies.json\", \"w\", encoding=\"utf-8\") as f:\n        json.dump(vacancies, f, ensure_ascii=False, indent=2)\n    print(f\"  Сохранено в vacancies.json\")\n\n\nif __name__ == \"__main__\":\n    main()\n'@","Cwd":"C:\\Users\\nise0","WaitMsBeforeAsync":5000,"toolAction":"Writing OAuth vacancy script","toolSummary":"hh.ru OAuth search script"}}]}
